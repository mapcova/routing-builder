{
    "name": "mapcova/graph-builder",
    "description": "Builds MapCova routing graphs (.mcr) from OpenStreetMap extracts in pure PHP, in resumable slices, for shared hosting.",
    "type": "library",
    "license": "AGPL-3.0-only",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MapCova\\GraphBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MapCova\\GraphBuilder\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G"
    }
}
